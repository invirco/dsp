# Build outputs
MW/*/DSP/SHARC/build/
attic/d24-adau1466/DSP_Export/
**/__pycache__/
*.o
*.doj
*.dxe
*.ldr
*.bak
*.map.xml

# CCES generated
*.is
linker_log.xml

# CCES toolchain — local install/copy, never tracked (use /opt/analog/cces per build.sh)
MW/D32/DSP/SHARC/cces/

# License material — keep local only
cces-license*.txt
license.dat

# Vendor documentation PDFs — fetched locally by fetch-*-docs.sh, never tracked
docs/**/*.pdf

# macOS metadata
._*
.DS_Store

# Generated test fixture (tools/dsp/gen_bqe_vectors.py, run by bqeverify.sh)
MW/D32/DSP/SHARC/src/lib/bqe_vectors.h
# Generated test fixture (tools/dsp/gen_bqg_vectors.py, run by bqguard.sh)
MW/D32/DSP/SHARC/src/lib/bqg_vectors.h

# logic_flash.sh writes its session log into the cwd it is run from
logic-flash.log

# Atomic intake (S44, S45). sync-defs.sh stages a backfilled product's bare
# expansion here and gen_dsp.py -- the only writer of the finished matrix --
# fills the DSP address columns and renames the result over
# MW/<P>/MX/_matrix.csv. Which products those are comes from
# `gen_dsp.py --backfill-products` (D32 and D24 since S45). The stage exists
# only between the two halves of a run.
MW/*/MX/_matrix.expansion.csv

# Temp files of those atomic writes: `.<target>.tmp.<pid>` beside the target
# (gen_dsp.py::_atomic_write) and `._matrix.expansion.<pid>.<product>.csv`
# (sync-defs.sh). They are removed on both the success and the failure path;
# a leftover is a killed process, never something to commit.
.*.tmp.[0-9]*
._matrix.expansion.[0-9]*.csv

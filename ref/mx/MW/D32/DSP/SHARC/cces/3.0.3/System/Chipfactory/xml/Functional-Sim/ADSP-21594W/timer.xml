<cces-chipfactory-xml schema-version="1" name="TIMER.xml">
	<version file-version="2.10.0.0"/>
	<module acronym="TIMER">
		<module-data>

			<!-- Register Block: TMR -->
			<block acronym="TMR" block_address_increment="32" count="16">
			<address radix="x" type="relative">60</address>
			</block>


			<register acronym="RUN" >
				<description>Run Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">4</address>
			</register>

		    
			<register acronym="RUN_SET" >
				<description>Run Set Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">8</address>
			</register>

		    
			<register acronym="RUN_CLR" >
				<description>Run Clear Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">c</address>
			</register>

		    
			<register acronym="STOP_CFG" >
				<description>Stop Configuration Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">10</address>
			</register>

		    
			<register acronym="STOP_CFG_SET" >
				<description>Stop Configuration Set Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">14</address>
			</register>

		    
			<register acronym="STOP_CFG_CLR" >
				<description>Stop Configuration Clear Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">18</address>
			</register>

		    
			<register acronym="DATA_IMSK" >
				<description>Data Interrupt Mask Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">1c</address>
			</register>

		    
			<register acronym="STAT_IMSK" >
				<description>Status Interrupt Mask Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">20</address>
			</register>

		    
			<register acronym="TRG_MSK" >
				<description>Trigger Master Mask Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">24</address>
			</register>

		    
			<register acronym="TRG_IE" >
				<description>Trigger Slave Enable Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">28</address>
			</register>

		    
			<register acronym="DATA_ILAT" >
				<description>Data Interrupt Latch Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">2c</address>
			</register>

		    
			<register acronym="STAT_ILAT" >
				<description>Status Interrupt Latch Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">30</address>
			</register>

		    
			<register acronym="ERR_TYPE" >
				<description>Error Type Status Register</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">34</address>
			</register>

		    
			<register acronym="BCAST_PER" >
				<description>Broadcast Period Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">38</address>
			</register>

		    
			<register acronym="BCAST_WID" >
				<description>Broadcast Width Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">3c</address>
			</register>

		    
			<register acronym="BCAST_DLY" >
				<description>Broadcast Delay Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">40</address>
			</register>

		    
			<register acronym="TMR[]_CFG" inBlock="TMR">
				<description>Timer n Configuration Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

		    
			<register acronym="TMR[]_CNT" inBlock="TMR">
				<description>Timer n Counter Register</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">4</address>
			</register>

		    
			<register acronym="TMR[]_PER" inBlock="TMR">
				<description>Timer n Period Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">8</address>
			</register>

		    
			<register acronym="TMR[]_WID" inBlock="TMR">
				<description>Timer n Width Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">c</address>
			</register>

		    
			<register acronym="TMR[]_DLY" inBlock="TMR">
				<description>Timer n Delay Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">10</address>
			</register>

		</module-data>
	</module>
</cces-chipfactory-xml>

<cces-memory-xml schema-version="1" name="ADSP-21835W-memory.xml">

<version file-version="3.0.3.0"/>

<!-- ********************************************* -->
<!-- *******   Memory Format Definitions   ******* -->
<!-- ********************************************* -->

<memory-format-definitions>
	<!-- SHARC-FX core formats -->
	<memory-format max-count="1" name="SHARC-FX DRAM" type="DATA"/>
	<memory-format max-count="1" name="SHARC-FX IRAM" type="ALL"/>

	<!-- Shared via MP space formats -->
	<memory-format max-count="1" name="SHARC-FX DRAM via MP space" type="DATA"/>
	<memory-format max-count="1" name="SHARC-FX IRAM via MP space" type="ALL"/>

	<!-- System MMRs -->
	<memory-format max-count="1" name="System MMRs" type="DATA"/>

	<!-- SPI Flash -->
	<memory-format max-count="1" name="SPI Flash" type="ALL"/>

	<!-- DDR -->
	<memory-format max-count="1" name="DDR (DMC0)" type="ALL"/>

	<!-- L2 SRAM -->
	<memory-format max-count="1" name="L2 SRAM" type="ALL"/>

	<!-- Boot ROM -->
	<memory-format max-count="1" name="L2 Boot ROM 0" type="ALL"/>
	<memory-format max-count="1" name="L2 Boot ROM 1" type="ALL"/>

</memory-format-definitions>

<!-- ************************************** -->
<!-- *******   Memory Definitions   ******* -->
<!-- ************************************** -->

<memory-definitions>
	<!-- ============================================================================================== -->
	<!-- CORE 1 (SHARC-FX) -->
	<!-- ============================================================================================== -->

	<!-- ============================================================================================== -->
	<!-- SHARC-FX DRAM and IRAM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="1" start="0x2F780000" end="0x2F7FFFFF" width="0x08" name="SHARC-FX DRAM" access="0xA" type="RAM INTERNAL" />
	<memory-segment core="P1" memory-id="2" start="0x2F800000" end="0x2F80FFFF" width="0x08" name="SHARC-FX IRAM" access="0x6" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- SHARC-FX DRAM and IRAM, in MP Space -->
	<!-- ============================================================================================== -->

	<!-- SHARC-FX -->
	<memory-segment core="P1" memory-id="3" start="0x28240000" end="0x282BFFFF" width="0x08" name="SHARC-FX DRAM via MP space" access="0x8" type="RAM EXTERNAL" />
	<memory-segment core="P1" memory-id="4" start="0x282C0000" end="0x282CFFFF" width="0x08" name="SHARC-FX IRAM via MP space" access="0x4" type="RAM EXTERNAL" />

	<!-- ============================================================================================== -->
	<!-- System MMRs -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="5" start="0x30000000" end="0x3FFFFFFF" width="0x08" name="System MMRs" access="0x1A" type="RAM INTERNAL MMR" />

	<!-- ============================================================================================== -->
	<!-- SPI Flash and DDR -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="6" start="0x60000000" end="0x7FFFFFFF" width="0x08" name="SPI Flash" access="0xD" type="ROM EXTERNAL FLASH" />
	<memory-segment core="P1" memory-id="7" start="0x80000000" end="0xBFFFFFFF" width="0x08" name="DDR (DMC0)" access="0xC" type="RAM EXTERNAL" />


	<!-- ============================================================================================== -->
	<!-- L2 SRAM (2MB) -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="8" start="0x20000000" end="0x201FFFFF" width="0x08" name="L2 SRAM" access="0xE" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- Boot ROM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="9" start="0x20200000" end="0x2020FFFF" width="0x08" name="L2 Boot ROM 0" access="0xF" type="ROM INTERNAL" />
	<memory-segment core="P1" memory-id="10" start="0x20210000" end="0x2021FFFF" width="0x08" name="L2 Boot ROM 1" access="0xF" type="ROM INTERNAL" />

</memory-definitions>

<memory-translation>
</memory-translation>

</cces-memory-xml>
<cces-chipfactory-xml schema-version="1" name="l2ctl.xml">
  <version file-version="2.9.0.1" />
  <module acronym="L2 Controller">
    <module-data>
      <!-- L2 Memory Blocks 8bit addresses-->
      <memory-region acronym="BOOT ROM0">
        <access mode="R/NW" />
        <address>    0x00000000</address>
        <end-address>0x00007FFF</end-address>
      </memory-region>
      <memory-region acronym="L2 RAM">
        <access mode="R/W" />
        <address>    0x20080000</address>
        <end-address>0x200BFFFF</end-address>
      </memory-region>

      <memory-region acronym="BOOT ROM1">
        <access mode="R/NW" />
        <address>    0x20100000</address>
        <end-address>0x20107FFF</end-address>
      </memory-region>
      <memory-region acronym="L2 ROM1">
        <access mode="R/NW" />
        <address>    0x20180000</address>
        <end-address>0x201B7FFF</end-address>
      </memory-region>

      <memory-region acronym="BOOT ROM2">
        <access mode="R/NW" />
        <address>    0x20200000</address>
        <end-address>0x20207FFF</end-address>
      </memory-region>
      <memory-region acronym="L2 ROM2">
        <access mode="R/NW" />
        <address>    0x20280000</address>
        <end-address>0x202BFFFF</end-address>
      </memory-region>

      <!-- MMRs-->
      <register acronym="CTL">
        <address>0</address>
      </register>
      <!-- ACTL_C0, ACTL_C1 and ACTL_SYS don't exist - SMPU controls access instead. -->
      <register acronym="ET0">
        <address>80</address>
      </register>
      <register acronym="ET1">
        <address>88</address>
      </register>
    </module-data>
  </module>
</cces-chipfactory-xml>

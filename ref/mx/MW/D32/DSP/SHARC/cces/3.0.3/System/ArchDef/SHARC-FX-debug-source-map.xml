	<!-- librtadi.a files -->
	<map source="Xtensa/SHARC-FX/lib/src/runtime/Source" destination="Xtensa/SHARC-FX/lib/src/runtime/Source"/>

	<!-- libosal_noos.a files -->
	<map source="noos/scripts/temp/osal/Source" destination="Xtensa/SHARC-FX/lib/src/osal_noos/Source"/>
	<map source="noos/scripts/temp/osal/Ports/SHARC-FX/CCES" destination="Xtensa/SHARC-FX/lib/src/osal_noos/Ports/SHARC-FX/CCES"/>


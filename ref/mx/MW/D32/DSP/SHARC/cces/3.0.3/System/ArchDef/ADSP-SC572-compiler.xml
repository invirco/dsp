<?xml version="1.0" standalone="yes"?>

<?xml-stylesheet type="text/xsl" href="AnomalySiliconRevisions.xsl"?>

<cces-compiler-xml schema-version="1" name="ADSP-SC572-compiler.xml">

<!-- *********************************************************************** -->
<!-- ******* ADSP-SC572-compiler.xml                                         -->
<!-- ******* Copyright 2015-2020 Analog Devices, Inc.  All rights reserved.  -->
<!-- *********************************************************************** -->

<!-- ***************************************** -->
<!-- ******* common information                -->
<!-- ***************************************** -->

<version file-version="2.10.0.1"/>

<core id="0" family="ARM">
  <architecture name="ADSP-SC572" maps-to="cortex-a5" fpu-name="neon-vfpv4" fpu-abi="ARM_FLOAT_ABI_HARD" machine-id="40" machine-id-mnemonic="EM_ARM" default-ldf="adsp-sc572.ld" default-crt="crt-sc572" default-apt="apt-sc572" inflection-point="SC573" num-cores="1"/>
  <silicon-revisions command-line-default="0.0">
     <silicon revision="0.0" lib-path="arm-none-eabi/lib/sc573_rev_any">
     </silicon>
     <silicon revision="0.2" lib-path="arm-none-eabi/lib/sc573_rev_any">
     </silicon>
     <silicon revision="any" lib-path="arm-none-eabi/lib/sc573_rev_any">
     </silicon>
  </silicon-revisions>
 
  <feature-macros>
          <macro name="__ADSPGCC__" value="1"/>
          <macro name="__ADSPARM__" value="1"/>
          <macro name="__ADSPCORTEXA5__" value="1"/>
          <macro name="__ADSPSC573_FAMILY__" value="1"/>
          <macro name="__ADSPSC572__" value="1"/>
          <macro name="__ADSPSC57x__" value="1"/>
          <macro name="__ADSPSC5xx__" value="1"/>
          <macro name="__ADSP2157x__" value="1"/>
          <macro name="__ADSP215xx__" value="1"/>
          <macro name="__HETEROGENEOUS_PROCESSOR__"  value="1"/>
          <macro name="__NUM_ARM_CORES__" value="1"/>
          <macro name="__NUM_SHARC_CORES__" value="1"/>
          <macro name="__NUM_CORES__" value="2"/>
  <!--    Feature specific macros -->
  </feature-macros>

</core>

<core id="1" family="SHARC">
  <architecture name="ADSP-SC572" maps-to="ADSP-SC572" machine-id="133" machine-id-mnemonic="EM_SHARC" default-ldf="SHARC/ldf/ADSP-SC572.ldf"/>
  
  <silicon-revisions command-line-default="0.0">
     <silicon revision="0.0" lib-path="SHARC/lib/sc573_rev_any">
        <workaround ix="2" compiler-default="Y" assembler-detect-default="Y"/>
        <workaround ix="69" compiler-default="Y"/>
        <workaround ix="83" compiler-default="Y" assembler-detect-default="Y"/>
        <workaround ix="96" assembler-detect-default="Y"/>
     </silicon>
     <silicon revision="0.2" lib-path="SHARC/lib/sc573_rev_any">
        <workaround ix="2" compiler-default="Y" assembler-detect-default="Y"/>
        <workaround ix="69" compiler-default="Y"/>
        <workaround ix="83" compiler-default="Y" assembler-detect-default="Y"/>
        <workaround ix="96" assembler-detect-default="Y"/>
     </silicon>
     <silicon revision="any" lib-path="SHARC/lib/sc573_rev_any">
        <workaround ix="2" compiler-default="Y" assembler-detect-default="Y"/>
        <workaround ix="69" compiler-default="Y"/>
        <workaround ix="83" compiler-default="Y" assembler-detect-default="Y"/>
        <workaround ix="96" assembler-detect-default="Y"/>
     </silicon>
  </silicon-revisions>
  
  <!-- ***************************************** -->
  <!-- ******* Anomaly Dictionary                -->
  <!-- ***************************************************** -->
  <!-- ** cross-referenced via the workaround *-ix above  ** -->
  <!-- ** in the workarounds per silicon revision.        ** -->
  <!-- ***************************************************** -->
  
  <cces-anomaly-dictionary name="SHARC-SC58X-anomaly.xml" />
  
  <feature-macros>
    <macro name="__ADSP21000__" value="1"/>
    <macro name="__ADSPSHARC__" value="0x210"/>
    <macro name="__ADSPSC573_FAMILY__" value="1"/>
    <macro name="__ADSPSC572__" value="1"/>
    <macro name="__ADSPSC57x__" value="1"/>
    <macro name="__ADSPSC5xx__" value="1"/>
    <macro name="__ADSP2157x__" value="1"/>
    <macro name="__ADSP215xx__" value="1"/>
    <macro name="__SIMDSHARC__" value="1"/>
    <macro name="__BA_SHARC__" value="1"/>
    <macro name="__FLT64_SHARC__" value="1"/>
    <macro name="__NUM_ARM_CORES__" value="1"/>
    <macro name="__NUM_SHARC_CORES__" value="1"/>
    <macro name="__NUM_CORES__" value="2"/>
    <macro name="__HETEROGENEOUS_PROCESSOR__" value="1"/>
  </feature-macros>
  
  <!-- ***************************************** -->
  <!-- ******* assembler specific information    -->
  <!-- ***************************************** -->
  <!-- ******* the flags-compiler is so the assembler knows how to invoke the  -->
  <!-- ******* C compiler when C structs in assembly features are present in   -->
  <!-- ******* an assembly program.                                            -->
  <!-- ***************************************** -->
  
  <assembler default-include-path="SHARC/include" flags-compiler="-proc ADSP-SC572"/>
  
  
  <!-- ***************************************** -->
  <!-- ******* compiler specific information     -->
  <!-- ***************************************** -->
  
  <compiler>
  
  	<!-- *************************************************************** -->
  	<!-- ** uses <architecture>, <silicon-revisions> and              ** -->
  	<!-- ** <feature-macros> from above. (shared with assembler)      ** -->
  	<!-- *************************************************************** -->
  
  	<compiler-assertions>
  		<assertion name="system" value="embedded"/>
  		<assertion name="machine" value="sharcXI"/>
  		<assertion name="cpu" value="sharcXI"/>
  		<assertion name="compiler" value="cc21k"/>
  	</compiler-assertions>
  
  	<compiler-includes>
  		<path name="SHARC/include"/>
  	</compiler-includes>
  
  	<compiler-reserved-registers>
  		<register name="b0"/>
  		<register name="b1"/>
  		<register name="b8"/>
  		<register name="b9"/>
  		<register name="l0"/>
  		<register name="l1"/>
  		<register name="l8"/>
  		<register name="l9"/>
  		<register name="m0"/>
  		<register name="m1"/>
  		<register name="m8"/>
  		<register name="m9"/>
  		<register name="i0"/>
  		<register name="i1"/>
  		<register name="i8"/>
  		<register name="i9"/>
  		<register name="mrb"/>
  		<register name="ustat1"/>
  		<register name="ustat2"/>
  		<register name="ustat3"/>
  		<register name="ustat4"/>
      <register name="PEyRegs" compiler-flag="-D__NOSIMD__" linker-flag="-MD__NOSIMD__"/>
  	</compiler-reserved-registers>
  
  	<compiler-flags-compiler>
  		<flags name="--target=XI"/>
  		<flags name="--mbk=internal"/>
  		<flags name="--mbk=external/r:5/w:5"/>
  		<flags name="--has_byte_addressing"/>
  	</compiler-flags-compiler>
  
  	<compiler-flags-asm>
  		<flags name="-proc"/>
  		<flags name="ADSP-SC572"/>
  	</compiler-flags-asm>
  
  	<compiler-flags-linker>
  		<flags name="-DADSP-SC572"/>
  	</compiler-flags-linker>
  
  	<!-- ************************************************** -->
  	<!-- ** do not include .exe suffix on tools paths as ** -->
  	<!-- ** driver will append when building for Windows ** -->
  	<!-- ************************************************** -->
  
  	<compiler-location-tools
  		driver-path="cc21k"
  		assembler-path="easm21k"
  		compiler-path="SHARC/etc/compiler"
  		prelinker-path="SHARC/etc/prelinker"
  		demangler-path="SHARC/etc/demangler"
  		ipasolver-path="SHARC/etc/ipa"
  		pgo-path="SHARC/etc/pgo"/>
  
  </compiler>
</core>
  
</cces-compiler-xml>

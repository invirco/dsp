<cces-chipfactory-xml schema-version="1" name="l2ctl.xml">
	<version file-version="2.9.0.9"/>
	<module acronym="L2 Controller">
		<module-data>
			<!-- L2 Memory Blocks 8bit addresses-->

			<memory-region acronym="L2 RAM">
				<access mode="R/W"/>
				<address>    0x200C0000</address>
				<end-address>0x200FFFFF</end-address>
			</memory-region>

			<memory-region acronym="BOOT ROM0">
				<access mode="R/NW"/>
				<address>    0x20100000</address>
				<end-address>0x20107FFF</end-address>
			</memory-region>

			<memory-region acronym="BOOT ROM1">
				<access mode="R/NW"/>
				<address>    0x20108000</address>
				<end-address>0x2010FFFF</end-address>
			</memory-region>

			<memory-region acronym="BOOT ROM2">
				<access mode="R/NW"/>
				<address>    0x20110000</address>
				<end-address>0x20117FFF</end-address>
			</memory-region>

			<!-- MMRs-->
			<register acronym="CTL">
				<address>0</address>
			</register>
			<!-- ACTL_C0, ACTL_C1 and ACTL_SYS don't exist - SMPU controls access instead. -->
			<register acronym="ET0">
				<address>80</address>
			</register>
			<register acronym="ET1">
				<address>88</address>
			</register>
		</module-data>
	</module>
</cces-chipfactory-xml>

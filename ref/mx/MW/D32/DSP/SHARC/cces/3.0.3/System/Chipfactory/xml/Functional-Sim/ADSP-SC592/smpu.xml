<cces-chipfactory-xml schema-version="1" name="SMPU.xml">
	<version file-version="2.10.0.0"/>
	<module acronym="SMPU">
		<module-data>

			<!-- Register Block: Rn -->
			<block acronym="Rn" block_address_increment="24" count="16">
				<address radix="x" type="relative">20</address>
			</block>

			<!-- Register Block: EXAn -->
			<block acronym="EXAn" block_address_increment="8" count="16">
				<address radix="x" type="relative">1a0</address>
			</block>

			<!-- Register Block: SECURERCTL -->
			<block acronym="SECURERCTL" block_address_increment="4" count="16">
				<address radix="x" type="relative">820</address>
			</block>


			<register acronym="CTL" >
				<description>SMPU Control</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

			<register acronym="STAT" >
				<description>SMPU Status</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">4</address>
			</register>

			<register acronym="IADDR" >
				<description>Interrupt Address</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">8</address>
			</register>

			<register acronym="IDTLS" >
				<description>Interrupt Details</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">c</address>
			</register>

			<register acronym="BADDR" >
				<description>Bus Error Address</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">10</address>
			</register>

			<register acronym="BDTLS" >
				<description>Bus Error Details</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">14</address>
			</register>

			<register acronym="RCTLn" inBlock="Rn">
				<description>Region n Control</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

			<register acronym="RADDRn" inBlock="Rn">
				<description>Region n Address</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">4</address>
			</register>

			<register acronym="RIDAn" inBlock="Rn">
				<description>Region n ID Register A</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">8</address>
			</register>

			<register acronym="RIDMSKAn" inBlock="Rn">
				<description>Region n ID Mask Register A</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">c</address>
			</register>

			<register acronym="RIDBn" inBlock="Rn">
				<description>Region n ID Register B</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">10</address>
			</register>

			<register acronym="RIDMSKBn" inBlock="Rn">
				<description>Region n ID Mask Register B</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">14</address>
			</register>

			<register acronym="EXACADDn" inBlock="EXAn">
				<description>Exclusive Access IDn Address</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

			<register acronym="EXACSTATn" inBlock="EXAn">
				<description>Exclusive Access Status</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">4</address>
			</register>

			<register acronym="REVID" >
				<description>SMPU Revision ID</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">220</address>
			</register>

			<register acronym="SECURECTL" >
				<description>SMPU Control Secure Accesses</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">800</address>
			</register>

			<register acronym="SECURERCTLn" inBlock="SECURERCTL">
				<description>Region n Control Secure Accesses</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

		</module-data>
	</module>
</cces-chipfactory-xml>

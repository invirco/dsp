<cces-chipfactory-xml schema-version="1" name="TWI.xml">
	<version file-version="2.11.0.0"/>
	<module acronym="TWI">
		<module-data>

			<register acronym="CLKDIV" >
				<description>SCL Clock Divider Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">0</address>
			</register>
 
			<register acronym="CTL" >
				<description>Control Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">4</address>
			</register>
 
			<register acronym="SLVCTL" >
				<description>Slave Mode Control Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">8</address>
			</register>
 
			<register acronym="SLVSTAT" >
				<description>Slave Mode Status Register</description>
				<access mode="R"/>
				<width>16</width>
				<address radix="x" type="relative">c</address>
			</register>
 
			<register acronym="SLVADDR" >
				<description>Slave Mode Address Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">10</address>
			</register>
 
			<register acronym="MSTRCTL" >
				<description>Master Mode Control Registers</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">14</address>
			</register>
 
			<register acronym="MSTRSTAT" >
				<description>Master Mode Status Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">18</address>
			</register>
 
			<register acronym="MSTRADDR" >
				<description>Master Mode Address Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">1c</address>
			</register>
 
			<register acronym="ISTAT" >
				<description>Interrupt Status Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">20</address>
			</register>
 
			<register acronym="IMSK" >
				<description>Interrupt Mask Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">24</address>
			</register>
 
			<register acronym="FIFOCTL" >
				<description>FIFO Control Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">28</address>
			</register>
 
			<register acronym="FIFOSTAT" >
				<description>FIFO Status Register</description>
				<access mode="R"/>
				<width>16</width>
				<address radix="x" type="relative">2c</address>
			</register>
 
			<register acronym="TXDATA8" >
				<description>Tx Data Single-Byte Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">80</address>
			</register>
 
			<register acronym="TXDATA16" >
				<description>Tx Data Double-Byte Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">84</address>
			</register>
 
			<register acronym="RXDATA8" >
				<description>Rx Data Single-Byte Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">88</address>
			</register>
 
			<register acronym="RXDATA16" >
				<description>Rx Data Double-Byte Register</description>
				<access mode="R/W"/>
				<width>16</width>
				<address radix="x" type="relative">8c</address>
			</register>

		</module-data>
	</module>
</cces-chipfactory-xml>

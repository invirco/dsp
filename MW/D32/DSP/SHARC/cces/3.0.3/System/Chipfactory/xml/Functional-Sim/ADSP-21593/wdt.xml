<cces-chipfactory-xml schema-version="1" name="WDT.xml">
	<version file-version="2.10.0.0"/>
	<module acronym="WDT">
		<module-data>


			<register acronym="CTL" >
				<description>Control Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>
		 
			<register acronym="CNT" >
				<description>Count Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">4</address>
			</register>
		 
			<register acronym="STAT" >
				<description>Watchdog Timer Status Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">8</address>
			</register>
		 
			<register acronym="WIN" >
				<description>Watchdog Timer Window Register</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">c</address>
			</register>

		</module-data>
	</module>
</cces-chipfactory-xml>

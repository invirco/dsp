<cces-chipfactory-xml schema-version="1" name="SPU.xml">
	<version file-version="2.10.0.0"/>
	<module acronym="SPU">
		<module-data>

	<!-- Register Block: WP -->
	<block acronym="WP" block_address_increment="4" count="256">
	<address radix="x" type="relative">400</address>
	</block>
 
	<!-- Register Block: SECUREC -->
	<block acronym="SECUREC" block_address_increment="4" count="3">
	<address radix="x" type="relative">980</address>
	</block>
 
	<!-- Register Block: SECUREP -->
	<block acronym="SECUREP" block_address_increment="4" count="256">
	<address radix="x" type="relative">a00</address>
	</block>


			<register acronym="CTL" >
				<description>Control Register</description>
		<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

			<register acronym="STAT" >
				<description>Status Register</description>
		<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">4</address>
			</register>

			<register acronym="WPn" inBlock="WP">
				<description>Write Protect Register n</description>
		<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

			<register acronym="SECURECTL" >
				<description>Secure Control Register</description>
		<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">840</address>
			</register>

			<register acronym="SECURECHK" >
				<description>Secure Check Register</description>
		<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">84c</address>
			</register>

			<register acronym="SECURECn" inBlock="SECUREC">
				<description>Secure Core Registers</description>
		<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

			<register acronym="SECUREPn" inBlock="SECUREP">
				<description>Secure Peripheral Register</description>
		<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>

		</module-data>
	</module>
</cces-chipfactory-xml>

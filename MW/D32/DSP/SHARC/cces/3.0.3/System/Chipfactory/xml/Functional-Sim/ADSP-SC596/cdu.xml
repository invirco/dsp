<cces-chipfactory-xml schema-version="1" name="CDU.xml">
	<version file-version="2.11.0.0"/>
	<module acronym="CDU">
		<module-data>

			<!-- Register Block: CFG -->
			<block acronym="CFG" block_address_increment="4" count="16">
				<address radix="x" type="relative">0</address>
			</block>

			<register acronym="CFGn" inBlock="CFG">
				<description>CDU Configuration</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">0</address>
			</register>
 
			<register acronym="STAT" >
				<description>CDU Status</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">40</address>
			</register>
 
			<register acronym="CLKINSEL" >
				<description>CLKIN Select</description>
				<access mode="R/W"/>
				<width>32</width>
				<address radix="x" type="relative">44</address>
			</register>
 
			<register acronym="REVID" >
				<description>CDU Revision ID</description>
				<access mode="R"/>
				<width>32</width>
				<address radix="x" type="relative">48</address>
			</register>

		</module-data>
	</module>
</cces-chipfactory-xml>

<cces-memory-xml schema-version="1" name="ADSP-SC835-memory.xml">

<version file-version="3.0.3.0"/>

<!-- ********************************************* -->
<!-- *******   Memory Format Definitions   ******* -->
<!-- ********************************************* -->

<memory-format-definitions>
	<!-- ARM core formats -->
	<memory-format max-count="1" name="ARM M33 Boot" type="ALL"/>
	<memory-format max-count="1" name="ARM M33 IRAM" type="ALL"/>

	<!-- SHARC-FX core formats -->
	<memory-format max-count="1" name="SHARC-FX DRAM" type="DATA"/>
	<memory-format max-count="1" name="SHARC-FX IRAM" type="ALL"/>

	<!-- Shared via MP space formats -->
	<memory-format max-count="2" name="ARM M33 Boot via MP space" type="ALL"/>
	<memory-format max-count="2" name="ARM M33 IRAM via MP space" type="ALL"/>
	<memory-format max-count="2" name="SHARC-FX DRAM via MP space" type="DATA"/>
	<memory-format max-count="2" name="SHARC-FX IRAM via MP space" type="ALL"/>

	<!-- Shared formats -->
	<memory-format max-count="2" name="ARM M33 DRAM" type="DATA"/>

	<!-- System MMRs -->
	<memory-format max-count="2" name="System MMRs" type="DATA"/>

	<!-- SPI Flash -->
	<memory-format max-count="2" name="SPI Flash" type="ALL"/>

	<!-- DDR -->
	<memory-format max-count="2" name="DDR (DMC0)" type="ALL"/>

	<!-- L2 SRAM -->
	<memory-format max-count="2" name="L2 SRAM" type="ALL"/>

	<!-- Boot ROM -->
	<memory-format max-count="2" name="L2 Boot ROM 0" type="ALL"/>
	<memory-format max-count="2" name="L2 Boot ROM 1" type="ALL"/>

</memory-format-definitions>

<!-- ************************************** -->
<!-- *******   Memory Definitions   ******* -->
<!-- ************************************** -->

<memory-definitions>
	<!-- ============================================================================================== -->
	<!-- CORE 1 (SHARC-FX) -->
	<!-- ============================================================================================== -->

	<!-- ============================================================================================== -->
	<!-- SHARC-FX DRAM and IRAM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="13" start="0x2F780000" end="0x2F7FFFFF" width="0x08" name="SHARC-FX DRAM" access="0xA" type="RAM INTERNAL" />
	<memory-segment core="P1" memory-id="14" start="0x2F800000" end="0x2F80FFFF" width="0x08" name="SHARC-FX IRAM" access="0x6" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- ARM M33 Boot ROM and IRAM, and SHARC-FX DRAM and IRAM, in MP Space -->
	<!-- ============================================================================================== -->

	<!-- ARM M33 -->
	<memory-segment core="P1" memory-id="15" start="0x28A40000" end="0x28A4FFFF" width="0x08" name="ARM M33 Boot via MP space" access="0xD" type="ROM EXTERNAL" />
	<memory-segment core="P1" memory-id="16" start="0x28A80000" end="0x28A8FFFF" width="0x08" name="ARM M33 IRAM via MP space" access="0x4" type="RAM EXTERNAL" />

	<!-- SHARC-FX -->
	<memory-segment core="P1" memory-id="17" start="0x28240000" end="0x282BFFFF" width="0x08" name="SHARC-FX DRAM via MP space" access="0x8" type="RAM EXTERNAL" />
	<memory-segment core="P1" memory-id="18" start="0x282C0000" end="0x282CFFFF" width="0x08" name="SHARC-FX IRAM via MP space" access="0x4" type="RAM EXTERNAL" />

	<!-- ============================================================================================== -->
	<!-- ARM M33 DRAM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="19" start="0x28AC0000" end="0x28ADFFFF" width="0x08" name="ARM M33 DRAM" access="0xA" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- System MMRs -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="20" start="0x30000000" end="0x3FFFFFFF" width="0x08" name="System MMRs" access="0x1A" type="RAM INTERNAL MMR" />

	<!-- ============================================================================================== -->
	<!-- SPI Flash and DDR -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="21" start="0x60000000" end="0x7FFFFFFF" width="0x08" name="SPI Flash" access="0xD" type="ROM EXTERNAL FLASH" />
	<memory-segment core="P1" memory-id="22" start="0x80000000" end="0xBFFFFFFF" width="0x08" name="DDR (DMC0)" access="0xC" type="RAM EXTERNAL" />


	<!-- ============================================================================================== -->
	<!-- L2 SRAM (2MB) -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="23" start="0x20000000" end="0x201FFFFF" width="0x08" name="L2 SRAM" access="0xE" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- Boot ROM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P1" memory-id="24" start="0x20200000" end="0x2020FFFF" width="0x08" name="L2 Boot ROM 0" access="0xF" type="ROM INTERNAL" />
	<memory-segment core="P1" memory-id="25" start="0x20210000" end="0x2021FFFF" width="0x08" name="L2 Boot ROM 1" access="0xF" type="ROM INTERNAL" />


	<!-- ============================================================================================== -->
	<!-- CORE 2 (ARM M33) -->
	<!-- ============================================================================================== -->

	<!-- ============================================================================================== -->
	<!-- ARM M33 Boot ROM and IRAM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P2" memory-id="0" start="0x00000000" end="0x0000FFFF" width="0x08" name="ARM M33 Boot" access="0xF" type="ROM INTERNAL" />
	<memory-segment core="P2" memory-id="1" start="0x00040000" end="0x0004FFFF" width="0x08" name="ARM M33 IRAM" access="0x6" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- ARM M33 Boot ROM and IRAM, and SHARC-FX DRAM and IRAM, in MP Space -->
	<!-- ============================================================================================== -->

	<!-- ARM M33 -->
	<memory-segment core="P2" memory-id="2" start="0x28A40000" end="0x28A4FFFF" width="0x08" name="ARM M33 Boot via MP space" access="0xD" type="ROM EXTERNAL" />
	<memory-segment core="P2" memory-id="3" start="0x28A80000" end="0x28A8FFFF" width="0x08" name="ARM M33 IRAM via MP space" access="0x4" type="RAM EXTERNAL" />

	<!-- SHARC-FX -->
	<memory-segment core="P2" memory-id="4" start="0x28240000" end="0x282BFFFF" width="0x08" name="SHARC-FX DRAM via MP space" access="0x8" type="RAM EXTERNAL" />
	<memory-segment core="P2" memory-id="5" start="0x282C0000" end="0x282CFFFF" width="0x08" name="SHARC-FX IRAM via MP space" access="0x4" type="RAM EXTERNAL" />

	<!-- ============================================================================================== -->
	<!-- ARM M33 DRAM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P2" memory-id="6" start="0x28AC0000" end="0x28ADFFFF" width="0x08" name="ARM M33 DRAM" access="0xA" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- System MMRs -->
	<!-- ============================================================================================== -->

	<memory-segment core="P2" memory-id="7" start="0x30000000" end="0x3FFFFFFF" width="0x08" name="System MMRs" access="0x1A" type="RAM INTERNAL MMR" />

	<!-- ============================================================================================== -->
	<!-- SPI Flash and DDR -->
	<!-- ============================================================================================== -->

	<memory-segment core="P2" memory-id="8" start="0x60000000" end="0x7FFFFFFF" width="0x08" name="SPI Flash" access="0xD" type="ROM EXTERNAL FLASH" />
	<memory-segment core="P2" memory-id="9" start="0x80000000" end="0xBFFFFFFF" width="0x08" name="DDR (DMC0)" access="0xC" type="RAM EXTERNAL" />

	<!-- ============================================================================================== -->
	<!-- L2 SRAM (2MB) -->
	<!-- ============================================================================================== -->

	<memory-segment core="P2" memory-id="10" start="0x20000000" end="0x201FFFFF" width="0x08" name="L2 SRAM" access="0xE" type="RAM INTERNAL" />

	<!-- ============================================================================================== -->
	<!-- Boot ROM -->
	<!-- ============================================================================================== -->

	<memory-segment core="P2" memory-id="11" start="0x20200000" end="0x2020FFFF" width="0x08" name="L2 Boot ROM 0" access="0xF" type="ROM INTERNAL" />
	<memory-segment core="P2" memory-id="12" start="0x20210000" end="0x2021FFFF" width="0x08" name="L2 Boot ROM 1" access="0xF" type="ROM INTERNAL" />

</memory-definitions>

<memory-translation>
</memory-translation>

</cces-memory-xml>
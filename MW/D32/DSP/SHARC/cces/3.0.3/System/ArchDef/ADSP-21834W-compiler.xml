<!-- ***************************************** -->
<!-- ******* common information                -->
<!-- ***************************************** -->

<version file-version="3.0.0.4"/>

<core id="1" family="SHARC-FX">

      <architecture name="ADSP-21834W" maps-to="ADSP-21834W" machine-id="94" machine-id-mnemonic="EM_XTENSA"/>

      <!-- Silicon revisions support -->
      <silicon-revisions command-line-default="0.0">
         <silicon revision="0.0" lib-path="SHARC-FX/lib/sc835w_rev_any" chip-id="0">
         </silicon>
         <silicon revision="any" lib-path="SHARC-FX/lib/sc835w_rev_any" chip-id="0">
         </silicon>
      </silicon-revisions>

      <!-- Predefined macros for SHARC-FX builds. -->
      <feature-macros>
              <macro name="__ADSPSC835_FAMILY__" value="1"/>
              <macro name="__ADSP21834W__" value="1"/>
              <macro name="__ADSP2183xW__" value="1"/>
              <macro name="__ADSP218xxW__" value="1"/>
              <macro name="__ADSP2183x__" value="1"/>
              <macro name="__ADSP218xx__" value="1"/>
              <macro name="__ADSPSHARCFX__" value="0x100"/>
              <macro name="__ADI_HAS_1MB_L2__" value="1"/>
              <macro name="__NUM_SHARC_CORES__" value="1"/>
              <macro name="__NUM_CORES__" value="1"/>
      </feature-macros>

      <!-- ***************************************** -->
      <!-- ******* Anomaly Dictionary                -->
      <!-- ***************************************************** -->
      <!-- ** cross-referenced via the workaround *-ix above  ** -->
      <!-- ** in the workarounds per silicon revision.        ** -->
      <!-- ***************************************************** -->

      <cces-anomaly-dictionary name="SHARC-FX-2183X-anomaly.xml" />

      <!-- ***************************************** -->
      <!-- ******* assembler specific information    -->
      <!-- ***************************************** -->

      <assembler flags-compiler=""/>

      <!-- ***************************************** -->
      <!-- ******* compiler specific information     -->
      <!-- ***************************************** -->

      <compiler>

            <compiler-includes>
                  <path name="SHARC-FX/include"/>
                  <path name="SHARC-FX/include/dsp"/>
            </compiler-includes>

            <compiler-flags-compiler>
            </compiler-flags-compiler>

            <compiler-flags-asm>
            </compiler-flags-asm>

            <compiler-flags-linker>
            </compiler-flags-linker>

            <compiler-location-tools driver-path="ccfx"/>

      </compiler>

</core>

</cces-compiler-xml>

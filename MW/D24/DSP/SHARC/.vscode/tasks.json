{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DSP: Build",
            "type": "shell",
            "command": "${workspaceFolder}/MW/D24/DSP/SHARC/build.sh",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "DSP: Clean",
            "type": "shell",
            "command": "${workspaceFolder}/MW/D24/DSP/SHARC/build.sh",
            "args": ["clean"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "DSP: Clean + Build",
            "type": "shell",
            "command": "${workspaceFolder}/MW/D24/DSP/SHARC/build.sh",
            "args": ["all"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "DSP: Validate CSV",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/MW/D24/DSP/SHARC/tools/dsp_validate.py",
                "${workspaceFolder}/MW/D24/DSP/SHARC/dsp.csv"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "DSP: Generate Diagram",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/MW/D24/DSP/SHARC/tools/dsp_diagram.py",
                "${workspaceFolder}/MW/D24/DSP/SHARC/dsp.csv",
                "${workspaceFolder}/MW/D24/DSP/SHARC/dsp_diagram.png"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "DSP: Generate ASM Skeletons",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/MW/D24/DSP/SHARC/tools/dsp_codegen.py",
                "${workspaceFolder}/MW/D24/DSP/SHARC/dsp.csv",
                "${workspaceFolder}/MW/D24/DSP/SHARC/src"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}

    +        unsigned char reg = matrix[pSys001Test001][RXD];
    +        unsigned char val = matrix[pSys001Test002][RXD];
    +        if (reg == 0xFF) { StartAK4619(); }
    +        else
    +        {
    +            unsigned char w[4] = { 0xC3, 0x00, reg, val };
    +            SpiTx(GPIOA, CS_C_Pin, 4, w);
    +        }
    +        matrix[pSys001Test002][RXF] = 0;
    +    }

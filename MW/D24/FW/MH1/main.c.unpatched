}

void IntToHex(int input, char *output) {
	output[0] = HEX[(input & 0xf000) >> 12];
	output[1] = HEX[(input & 0xf00) >> 8];
	output[2] = HEX[(input & 0xf0) >> 4];
	output[3] = HEX[input & 0xf];
}


# dsp4_logic.qsf — Quartus settings for the DSP4 LOGIC CPLD (U3)
#
# Pin assignments extracted 2026-07-31 from the rev C LOGIC sheet
# (D24 DSP.pdf page 2/10, 300 DPI render, all four pin banks read).
# The X-logic parking and S4 personality assignments this file used to
# carry are GONE, not provisional: D32 is out of requirements (PW
# 2026-09-25) and the S109 per-pin audit against the netlist settled
# every one of them. See the notes at PIN_70, PIN_109-111 and PIN_137.
set_global_assignment -name FAMILY "MAX V"
set_global_assignment -name DEVICE 5M1270ZT144C4
set_global_assignment -name TOP_LEVEL_ENTITY dsp4_logic_top
set_global_assignment -name VERILOG_FILE ../rtl/dsp4_logic_top.v
set_global_assignment -name VERILOG_FILE ../rtl/dsp4_clkgen.v
set_global_assignment -name VERILOG_FILE ../rtl/dsp4_pcm_reframe.v
set_global_assignment -name SDC_FILE dsp4_logic.sdc
set_global_assignment -name SEARCH_PATH ../rtl
set_global_assignment -name SEARCH_PATH ../generated
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
# Unused pins: inputs, tri-stated with weak pull-up (mandatory — this CPLD
# shares copper with the MH/panel UARTs and the S-MCU matrix nets, so a
# driven unused pin is a bus fight, not a cosmetic default).
#
# TRAP, hardware-proven 2026-08-19: RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP is
# NOT the setting. It is a subordinate assignment whose Quartus default is
# already "As input tri-stated with weak pull-up" (see
# quartus/linux64/assignment_defaults.qdf:494); setting it does nothing on
# its own and leaves the PRIMARY assignment below unspecified, which then
# defaults to "As output driving ground". Both the f827e124 and the
# committed 2be52d4ad5b5 builds shipped that way and ground-drove
# MHRX/MHTX/SRX/MRX/PTRX/S5-7/BUSY, killing the MH and panel UARTs.
# ALWAYS confirm in output_files/dsp4_logic.fit.rpt ("Reserve all unused
# pins" in the Fitter Device Options table) — do not trust this line.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"

# ---- Clock / system ----
set_location_assignment PIN_88  -to sysclk
set_location_assignment PIN_140 -to dsp_clk

# ---- Converter / option-slot clock pair (was read as straps) ----
# Pins 142 (C1) and 141 (L0) are the bit clock and frame sync for the
# ADC/DAC FPC and for all three option slots, through 33R taps; U3 is
# their only driver. Pins 87 (C0), 85 (C2) and 81 (L1) are single-pin
# nets that reach nothing and are now left to the global unused-pin
# reservation instead of being sampled as straps. See the port comment
# in rtl/dsp4_logic_top.v and the S34 write-up.
set_location_assignment PIN_142 -to conv_bck
set_location_assignment PIN_141 -to conv_fs

# PIN_70 (net `M MCU_S4`) WAS `strap_d32` AND IS NOW UNASSIGNED (S109).
# D32 is out of requirements (PW 2026-09-25), so there is no product
# personality to read. The pin never had a defined level anyway: the net
# has exactly two pins (U3.70 and the M MCU U8.11), no pull resistor, and
# MAX V offers a weak pull-UP only -- so it floated HIGH on every D24 and
# tied the codec DAC to zero (S108). It now falls to the global unused-pin
# reservation, which leaves this end an input and cannot mute anything.

# ---- DSP clock pairs ----
set_location_assignment PIN_20  -to bcki[0]
set_location_assignment PIN_21  -to bcki[1]
set_location_assignment PIN_22  -to bcki[2]
set_location_assignment PIN_23  -to bcki[3]
set_location_assignment PIN_38  -to bcki[4]
set_location_assignment PIN_39  -to bcki[5]
set_location_assignment PIN_40  -to bcki[6]
set_location_assignment PIN_41  -to bcki[7]
set_location_assignment PIN_14  -to fsi[0]
set_location_assignment PIN_15  -to fsi[1]
set_location_assignment PIN_16  -to fsi[2]
set_location_assignment PIN_18  -to fsi[3]
set_location_assignment PIN_30  -to fsi[4]
set_location_assignment PIN_31  -to fsi[5]
set_location_assignment PIN_32  -to fsi[6]
set_location_assignment PIN_37  -to fsi[7]

# ---- DSPA inputs / DSPB outputs ----
set_location_assignment PIN_24  -to i_dspa[0]
set_location_assignment PIN_27  -to i_dspa[1]
set_location_assignment PIN_28  -to i_dspa[2]
set_location_assignment PIN_29  -to i_dspa[3]
set_location_assignment PIN_42  -to i_dspa[4]
set_location_assignment PIN_43  -to i_dspa[5]
set_location_assignment PIN_44  -to i_dspa[6]
set_location_assignment PIN_45  -to i_dspa[7]
set_location_assignment PIN_48  -to o_dspb[0]
set_location_assignment PIN_49  -to o_dspb[1]
set_location_assignment PIN_50  -to o_dspb[2]
set_location_assignment PIN_51  -to o_dspb[3]
set_location_assignment PIN_52  -to o_dspb[4]
set_location_assignment PIN_53  -to o_dspb[5]
set_location_assignment PIN_55  -to o_dspb[6]
set_location_assignment PIN_57  -to o_dspb[7]

# ---- Converter lanes ----
set_location_assignment PIN_139 -to ad[0]
set_location_assignment PIN_138 -to ad[1]
set_location_assignment PIN_134 -to ad[2]
set_location_assignment PIN_133 -to ad[3]
set_location_assignment PIN_132 -to da[0]
set_location_assignment PIN_131 -to da[1]
set_location_assignment PIN_130 -to da[2]
set_location_assignment PIN_129 -to da[3]

# ---- Network lanes ----
set_location_assignment PIN_6   -to ni[0]
set_location_assignment PIN_5   -to ni[1]
set_location_assignment PIN_4   -to ni[2]
set_location_assignment PIN_3   -to ni[3]
set_location_assignment PIN_2   -to no[0]
set_location_assignment PIN_1   -to no[1]
set_location_assignment PIN_144 -to no[2]
set_location_assignment PIN_143 -to no[3]

# ---- Codec ----
set_location_assignment PIN_123 -to cdc_o
set_location_assignment PIN_124 -to cdc_i

# ---- Panel MEMS mic, through the ADAU7002 PDM bridge (digital U13) ----
#
# PIN_137 (`LOGIC_MEMS`, G2637) WAS `mems` AND IS NOW UNASSIGNED. It is a
# dead stub: U3.137 -> dsp J1.26/J2.26 -> digital J18.26 and nothing else,
# no load on the far side (mx26 docs/d24-netlist-global.md:468-472, and
# confirmed pin by pin in the S109 audit). Every bitstream from 3b48f468
# onwards read the panel mic off that stub, which is why MM1 has never
# passed anywhere.
#
# The mic's data arrives on PIN_121, and U13 is a SLAVE that needs a bit
# clock and a frame sync from this part. On M_BCK and M_FS the only active
# device pins are U3.119/U3.120 and U13's own inputs, so U3 is the sole
# driver of both and driving them fights nothing.
set_location_assignment PIN_119 -to mems_bck
set_location_assignment PIN_120 -to mems_fs
set_location_assignment PIN_121 -to mems_i2s

# WEAK PULL-UP ON THE DATA PIN, DELIBERATELY. The ADAU7002 TRI-STATES
# SDATA outside the two slots it owns (datasheet Rev. A, Figures 15-18) --
# six of eight slots plus the low 12 bits of its own two, because it emits
# 20 bits into a 32-bit slot. `M_I2S` has no pull resistor on the board
# (U3.121, J18.59 and U13.B1 are the whole net), so without this the pin
# floats for most of every frame, which is the crowbar-current case the
# snake pins already carry a pull-up for. The datasheet's Figure 11 asks
# for a pull-DOWN instead; MAX V cannot do that, and an ECO is the only
# way to get one (S109-3). A pull-up costs the lane nothing: the floating
# bits are the low 12 of a 32-bit word, 2**-19 of full scale.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to mems_i2s

# ---- PIN_109/110/111: the D32 snake pins, now UNASSIGNED (S109) ----
#
# These were snake_in / snake_out / dac_main. D32 is out of requirements
# (PW 2026-09-25) and the netlist says the outputs were pointed the wrong
# way regardless: U3.110 = LOGIC_PLL5_1 = digital J2.A13 [NO7] = opt2
# SLOT.A13 and U3.111 = LOGIC_PLL5_2 = digital J2.A10 [NO4] = opt2
# SLOT.A10 -- the board labels both as the option CARD's outputs, and the
# strap that was supposed to keep them high-Z read HIGH on every D24, so
# they were driven the whole time. PIN_109 (NO6) was an input and was
# direction-correct; it has no source now that the snake is gone.
#
# Unassigning all three gives them the global reservation -- input,
# tri-stated, weak pull-up -- which is the state the explicit pull-ups
# below used to buy, minus the strap that could undo it.

# ---- Pi PCM (roles per hardware-map: 0=CLK 1=DOUT 2=DIN 3=FS) ----
set_location_assignment PIN_80  -to pcm_clk
set_location_assignment PIN_86  -to pcm_dout
set_location_assignment PIN_63  -to pcm_din
set_location_assignment PIN_79  -to pcm_fs

# ---- Status ----
set_location_assignment PIN_59  -to blink_led

# ---- Bring-up test points (-> J1/J2 P17-P20 -> D24 Digital J15, DNP) ----
set_location_assignment PIN_13  -to test[0]
set_location_assignment PIN_12  -to test[1]
set_location_assignment PIN_8   -to test[2]
set_location_assignment PIN_7   -to test[3]

# Unassigned board pins intentionally left unconstrained (reserved as
# tri-stated inputs by the global above):
# !BLINK (58), ISPI0/ISPI1/ICS_L (60,61,62 - provisioned S-MCU SPI),
# BUSY (66), S5-S7 (69,68,67), UART pass-throughs SRX/MRX (72,71),
# MHTX/MHRX (73,74), STRX1/STRX0 (75,76), PTRX1/PTRX0 (77,84),
# PLL1-4 groups (89-108 X-logic), PLL5_0-PLL7_3 except 119/120/121
# (109-118, 122 X-logic), strap PIN_70, MEMS stub PIN_137.

# ---- MHRX (pin 74): reserved input, NO weak pull-up (S41, folded in S42) ----
#
# `M MCU_P17` / G2691 = the CM4's UART0 TX (GPIO14, J24.55), which the
# power MCU U34 also watches on PA0 as its "Pi alive" sense. The global
# RESERVE_ALL_UNUSED_PINS above reserves this pin as an input WITH a weak
# pull-up, and that pull-up holds the net HIGH after the Pi halts (GPIO14
# goes to an input at shutdown). The power MCU then never sees the
# sustained low it acks on, so a rocker-off shutdown with the Pi still
# running runs to the 60 s failsafe (bench 2026-08-18; power-MCU firmware
# mx26 ba9b2bc).
#
# The pin comes out of the global reservation BY NAME and nothing else
# does: the global line stays, because it is the 2026-08-19 trap's fix and
# the MH/panel UARTs need it (S41-1).
#
# The pin is reserved as an input here purely to take the pull-up off it.
# That is not a bus fight: the only driver on the net is the CM4,
# push-pull, and this end stays an input either way. When the Pi is up the
# UART idles high and the net is held by the CM4; when the Pi halts the net
# falls, which is the whole point.
#
# PROVED ON THE PART (S41-4), in the step-0 lineage, with a control arm and
# no scope — the CM4 itself is the instrument. Release GPIO14 from the PL011
# and read the net: step 0 -> hi (against the CM4's own ~50 k pull-down, so
# an external pull-up stronger than 50 k = the MAX V weak pull-up); this fix
# -> lo. Rollback -> hi again, re-flash -> lo again. Four plays, four
# agreements. M MCU U8 pin 32 is NOT a second pull-up source.
set_location_assignment PIN_74 -to mhrx
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to mhrx
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to mhrx
